// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth
// ============================================================

model User {
  id            String   @id
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  tests    Test[]
  attempts Attempt[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// App Logic
// ============================================================

model Test {
  id          String  @id @default(cuid())
  name        String
  description String?

  duration         Int?
  marksPerQuestion Float    @default(2)
  negativeMark     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  Attempt[]

  @@index([userId])
  @@map("test")
}

model Question {
  id              String   @id @default(cuid())
  text            String
  image           String?
  options         Option[]
  correctOptionId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  correctOption Option?  @relation("CorrectOption", fields: [correctOptionId], references: [id], onDelete: SetNull)
  answers       Answer[]

  @@index([testId])
  @@map("question")
}

model Option {
  id    String  @id @default(cuid())
  text  String
  image String?

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  correctFor Question? @relation("CorrectOption")
  answers    Answer[]

  @@index([questionId])
  @@map("option")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id          String        @id @default(cuid())
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  status      AttemptStatus @default(IN_PROGRESS)

  userId String
  testId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  answers Answer[]
  result  Result?

  @@index([userId])
  @@index([testId])
  @@map("attempt")
}

model Answer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  // Optional: Nullable to track "Unattempted" or "Skipped" states cleanly

  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answer")
}

model Result {
  id String @id @default(cuid())

  score            Float
  correctCount     Int
  wrongCount       Int
  unattemptedCount Int
  accuracy         Float
  timeTaken        Int

  createdAt DateTime @default(now())

  // One Result belongs to exactly one Attempt
  attemptId String  @unique
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("result")
}
